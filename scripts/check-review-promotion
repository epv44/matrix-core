#!/bin/sh
set -eu

stage="${1:-}"
shift || true

case "$stage" in
  stage-1)
    exec node --import tsx tools/agentsmith-evals/src/cli.ts baseline validate "$@"
    ;;
  stage-4)
    exec node --import tsx tools/agentsmith-evals/src/promotion-cli.ts "$@"
    ;;
  *)
    echo "usage: ./scripts/check-review-promotion {stage-1|stage-4} [options]" >&2
    exit 2
    ;;
esac
