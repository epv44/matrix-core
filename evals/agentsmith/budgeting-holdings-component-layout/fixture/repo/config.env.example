# Plaid API credentials
# Access tokens are stored in macOS Keychain, not here.
PLAID_CLIENT_ID=your_client_id_here
PLAID_SECRET=your_production_secret_here
PLAID_SANDBOX_SECRET=sandbox_$your_sandbox_secret_here

# Environment is chosen per command with --env sandbox|production (default: sandbox).
# Link institutions from the Link / Sync page after starting the web stack.
# Never set the Plaid environment in .env; use the application's environment toggle.

# Institutions are registered in the DB on link (the DB is the source of truth; no env list).

# Database path (defaults to ./finance.db)
# DB_PATH=/absolute/path/to/finance.db
# Identity is shared across sandbox and production (default: ./finance_identity.db)
# IDENTITY_DB_PATH=/absolute/path/to/finance_identity.db

# Household HTTPS mode sets this automatically. Keep false for direct localhost HTTP.
# SESSION_COOKIE_SECURE=true

# OAuth-capable Plaid Link redirect. ./run.sh --lan sets this automatically to
# https://<BUDGET_LAN_HOST>:3443/oauth/callback. Register the same URL in the
# Plaid Dashboard -> Team Settings -> API -> Allowed redirect URIs.
# PLAID_REDIRECT_URI=https://192.168.0.51:3443/oauth/callback

# LAN production mode (./run.sh --lan). Defaults to <MacName>.local and
# certs/lan.pem + certs/lan-key.pem. Set BUDGET_LAN_HOST to the Mac's LAN IP
# (with a static DHCP lease) so Android devices and the Plaid redirect work.
# BUDGET_LAN_HOST=192.168.0.51
# BUDGET_LAN_PORT=3443
# BUDGET_LAN_CERT=/absolute/path/to/certs/lan.pem
# BUDGET_LAN_KEY=/absolute/path/to/certs/lan-key.pem

# Log level (DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=INFO

# Log file (absolute path; default <project_root>/logs/finance.log). Rotating: 5MB x 5.
# LOG_FILE=/var/log/finance/finance.log

# Public webhook URL for Plaid historical-pull notifications (TRANSACTIONS webhooks).
# This must point at the standalone WEBHOOK RECEIVER (finance/webhook_receiver.py, port 9000),
# NOT the main API on 8000 (which must never be exposed). Plaid must reach it from the internet.
# With a valid ngrok URL, ./run.sh starts and supervises the local tunnel automatically:
# WEBHOOK_URL=https://<your-id>.ngrok-free.dev/webhook
# Other HTTPS webhook domains are treated as externally managed. Invalid URLs stop startup.
# The receiver verifies Plaid's signed Plaid-Verification JWT before forwarding to the local API.
# When set, new links may request up to 24 months and the webhook queues the
# historical pull. When unset, new link requests are capped at 30 days.
WEBHOOK_URL=

# Credential backend. macOS defaults to Keychain. DGX/Linux should use encrypted-file.
# TOKEN_STORE_BACKEND=encrypted-file
# TOKEN_STORE_PATH=/var/lib/budget-app/plaid-tokens.enc
# TOKEN_STORE_KEY_FILE=/etc/budget-app/token-store.key

# Local HTTPS for Plaid Link (production/OAuth banks require an HTTPS redirect URI):
#   brew install mkcert && mkcert -install
#   mkdir -p certs && cd certs && mkcert -cert-file localhost.pem -key-file localhost-key.pem localhost 127.0.0.1 ::1
# Register https://localhost:8080/callback in Plaid Dashboard > Team Settings > API > Allowed redirect URIs.
# LINK_REDIRECT_PORT=8080
