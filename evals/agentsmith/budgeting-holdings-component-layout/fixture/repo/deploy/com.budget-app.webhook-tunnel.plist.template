<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.budget-app.webhook-tunnel</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NGROK_BIN__</string>
    <string>http</string>
    <string>9000</string>
    <string>--url</string>
    <string>__NGROK_ORIGIN__</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>__PROJECT_ROOT__/logs/webhook-tunnel.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT_ROOT__/logs/webhook-tunnel-error.log</string>
</dict>
</plist>
