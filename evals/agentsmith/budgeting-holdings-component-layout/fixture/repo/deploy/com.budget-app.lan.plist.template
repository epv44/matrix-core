<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.budget-app.lan</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>BUDGET_LAN_HOST</key>
    <string>__BUDGET_LAN_HOST__</string>
  </dict>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd '__PROJECT_ROOT__' &amp;&amp; exec ./run.sh --lan</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__PROJECT_ROOT__/logs/lan-launch.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT_ROOT__/logs/lan-launch-error.log</string>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
